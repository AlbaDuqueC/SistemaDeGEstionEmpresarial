@model Domain.dto.PersonaConListadoDepartamento

@{
    ViewData["Title"] = "Editar Persona";
}

<h2>Editar Persona</h2>

<hr />

<div class="row">
    <div class="col-md-8">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="Persona.ID" />

            <div class="form-group mb-3">
                <label class="form-label">ID</label>
                <input value="@Model.Persona.ID" class="form-control" disabled />
                <small class="form-text text-muted">El ID no se puede modificar</small>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Persona.Nombre" class="form-label">Nombre</label>
                <input asp-for="Persona.Nombre" class="form-control" required />
                <span asp-validation-for="Persona.Nombre" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Persona.Apellidos" class="form-label">Apellidos</label>
                <input asp-for="Persona.Apellidos" class="form-control" required />
                <span asp-validation-for="Persona.Apellidos" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Persona.Telefono" class="form-label">Teléfono</label>
                <input asp-for="Persona.Telefono" class="form-control" />
                <span asp-validation-for="Persona.Telefono" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Persona.Direccion" class="form-label">Dirección</label>
                <input asp-for="Persona.Direccion" class="form-control" />
                <span asp-validation-for="Persona.Direccion" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Persona.Foto" class="form-label">URL de la Foto</label>
                <input asp-for="Persona.Foto" class="form-control" placeholder="https://ejemplo.com/foto.jpg" />
                <span asp-validation-for="Persona.Foto" class="text-danger"></span>
                @if (!string.IsNullOrEmpty(Model.Persona.Foto))
                {
                    <div class="mt-2">
                        <img src="@Model.Persona.Foto" alt="Vista previa" style="max-width: 150px;" class="img-thumbnail" />
                    </div>
                }
            </div>

            <div class="form-group mb-3">
                <label asp-for="Persona.FechaNacimiento" class="form-label">Fecha de Nacimiento</label>
                <input asp-for="Persona.FechaNacimiento"
                       type="date"
                       class="form-control"
                       value="@(Model.Persona.FechaNacimiento != DateTime.MinValue ? Model.Persona.FechaNacimiento.ToString("yyyy-MM-dd") : "")" />
                <span asp-validation-for="Persona.FechaNacimiento" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Persona.IdDepartamento" class="form-label">Departamento</label>
                <select asp-for="Persona.IdDepartamento" class="form-select" required>
                    <option value="">-- Seleccione un departamento --</option>
                    @foreach (var dept in Model.ListadoDepartamento)
                    {
                        <option value="@dept.ID" selected="@(dept.ID == Model.Persona.IdDepartamento)">@dept.Nombre</option>
                    }
                </select>
                <span asp-validation-for="Persona.IdDepartamento" class="text-danger"></span>
            </div>

            <div class="form-group mt-4">
                <input type="submit" value="Guardar cambios" class="btn btn-primary" />
                <a asp-action="Mostrar" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
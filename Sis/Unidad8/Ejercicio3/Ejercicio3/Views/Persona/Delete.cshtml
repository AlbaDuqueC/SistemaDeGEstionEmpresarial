@model Domain.dto.PersonaConNombreDepartamento

@{
    ViewData["Title"] = "Eliminar Persona";
}

<h2>Eliminar Persona</h2>

<div class="alert alert-danger">
    <h4>¿Está seguro que desea eliminar esta persona?</h4>
    <p>Esta acción no se puede deshacer.</p>
</div>

<div class="card">
    <div class="card-header bg-danger text-white">
        <h5>Datos de la Persona a Eliminar</h5>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">ID</dt>
            <dd class="col-sm-9">@Model.Persona.ID</dd>

            <dt class="col-sm-3">Nombre</dt>
            <dd class="col-sm-9">@Model.Persona.Nombre</dd>

            <dt class="col-sm-3">Apellidos</dt>
            <dd class="col-sm-9">@Model.Persona.Apellidos</dd>

            <dt class="col-sm-3">Teléfono</dt>
            <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Persona.Telefono) ? "No especificado" : Model.Persona.Telefono)</dd>

            <dt class="col-sm-3">Dirección</dt>
            <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Persona.Direccion) ? "No especificada" : Model.Persona.Direccion)</dd>

            <dt class="col-sm-3">Foto</dt>
            <dd class="col-sm-9">
                @if (!string.IsNullOrEmpty(Model.Persona.Foto))
                {
                    <img src="@Model.Persona.Foto" alt="Foto de @Model.Persona.Nombre" style="max-width: 150px;" class="img-thumbnail" />
                }
                else
                {
                    <span>No tiene foto</span>
                }
            </dd>

            <dt class="col-sm-3">Fecha de Nacimiento</dt>
            <dd class="col-sm-9">
                @if (Model.Persona.FechaNacimiento != DateTime.MinValue)
                {
                    @Model.Persona.FechaNacimiento.ToString("dd/MM/yyyy")
                }
                else
                {
                    <span>No especificada</span>
                }
            </dd>

            <dt class="col-sm-3">Departamento</dt>
            <dd class="col-sm-9">@Model.NombreDepartamento</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post" class="mt-3">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Persona.ID" />

    <button type="submit" class="btn btn-danger">
        <i class="bi bi-trash"></i> Confirmar Eliminación
    </button>
    <a asp-action="Mostrar" class="btn btn-secondary">Cancelar</a>
</form>